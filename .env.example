# Populated automatically in .env.local by `clerk init` / `clerk env pull`
# (see the Clerk CLI: https://clerk.com/docs/cli). To set up manually instead:
# get these at https://dashboard.clerk.com — set sign-in to "restricted" / invite-only
# so reviewers can't self-sign-up, then invite each reviewer's email from the dashboard.
VITE_CLERK_PUBLISHABLE_KEY=

# Not currently used by any app code (this is a pure static SPA with no backend) —
# provisioned for a future server-side integration. Never reference this in client code.
CLERK_SECRET_KEY=
